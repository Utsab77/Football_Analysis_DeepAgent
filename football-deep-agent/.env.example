# LLM API (pick one, or keep both and select via LLM_PROVIDER)
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Football data source
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=

# Database (leave blank to use local SQLite/file storage during early phases)
DATABASE_URL=postgresql://user:password@localhost:5432/football_agent
