# LLM API Configuration
# Three API keys for three sub-agents (OpenRouter)
LLM_PROVIDER=openrouter

# Sub-Agent 1: Team Analysis Agent
# Used for: team strength, form, home/away analysis
# Get your key from: https://openrouter.ai/keys
SUB_AGENT_1_API_KEY=your-openrouter-api-key-here

# Sub-Agent 2: Historical Analysis Agent
# Used for: head-to-head records, historical trends
SUB_AGENT_2_API_KEY=your-openrouter-api-key-here

# Sub-Agent 3: Scenario Agent
# Used for: what-if analysis, player absence, formation changes
SUB_AGENT_3_API_KEY=your-openrouter-api-key-here

# Legacy keys (optional, can use the sub-agent keys above)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Football data source
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=

# Database (leave blank to use local SQLite/file storage during early phases)
DATABASE_URL=postgresql://user:password@localhost:5432/football_agent
